model StockLedger {
  id            BigInt       @id @default(autoincrement())
  itemId        String       @map("item_id")
  warehouseId   String       @map("warehouse_id")
  qty           Decimal      @db.Decimal(15, 4)
  referenceType String       @map("reference_type")
  referenceId   String       @map("reference_id")
  createdAt     DateTime     @default(now()) @map("created_at")
  locationId    String?      @map("location_id")
  movementType  MovementType @map("movement_type")
  rate          Decimal?     @db.Decimal(15, 4)
  unitCost      Decimal?     @map("unit_cost") @db.Decimal(15, 4)
  item          Item         @relation(fields: [itemId], references: [id])
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])

  // --- Stock level / balance checks ---
  @@index([itemId, warehouseId])
  @@index([itemId, locationId])
  @@index([itemId, warehouseId, locationId])

  // --- Date-range report indexes (THE critical missing ones) ---
  @@index([itemId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([locationId, createdAt])
  @@index([itemId, warehouseId, createdAt])
  @@index([movementType, createdAt])

  // --- Lookup indexes ---
  @@index([referenceId])
  @@index([movementType])

  @@map("stock_ledgers")
}

enum MovementType {
  INBOUND
  OUTBOUND
  TRANSFER
  ADJUSTMENT
  OPENING_BALANCE
}

model MonthlyStockSnapshot {
  id          String   @id @default(uuid())
  date        DateTime @db.Date
  itemId      String   @map("item_id")
  warehouseId String   @map("warehouse_id")
  locationId  String?  @map("location_id")
  closingQty  Decimal  @db.Decimal(15, 4) @map("closing_qty")
  unitCost    Decimal? @db.Decimal(15, 4) @map("unit_cost")

  item        Item      @relation(fields: [itemId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  location    Location? @relation(fields: [locationId], references: [id])

  @@unique([date, itemId, warehouseId, locationId])
  @@index([date])
  @@index([itemId, date])
  @@index([warehouseId, date])
  @@index([locationId, date])
  
  @@map("monthly_stock_snapshots")
}
